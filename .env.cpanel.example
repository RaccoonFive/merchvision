# Copy to .env on the cPanel server; keep your local development .env separate.
NODE_ENV=production
BETTER_AUTH_URL="https://merchvision.kevenparent.com"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"

# Use the full database/user names from cPanel and URL-encode the password.
DATABASE_URL="mysql://CPANEL_DATABASE_USER:URL_ENCODED_PASSWORD@localhost:3306/CPANEL_DATABASE_NAME"
# Replace with an email address or another contact where you can be reached.
USER_AGENT_CONTACT="replace-with-your-contact"

OSRS_LATEST_CACHE_SECONDS=60
OSRS_MAPPING_CACHE_SECONDS=86400
OSRS_TIMESERIES_CACHE_SECONDS=300
# Optional: only needed if you enable the calibration scheduler.
CRON_SECRET="replace-with-a-separate-random-secret"
